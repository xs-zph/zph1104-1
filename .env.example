# ============================================================
# AI客服工单自动化系统 配置文件（示例）
# 使用方法：复制本文件为 .env，然后填入你自己的密钥
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# ============================================================

# ---- DeepSeek 大模型 ----
# DeepSeek API 密钥（必填）。到 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=sk-你的密钥
# 模型：deepseek-chat（V3，快）/ deepseek-reasoner（R1，带深度推理）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- MySQL 数据库 ----
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DB=ai_ticket

# ---- 业务参数 ----
# 分类置信度阈值：低于该值的工单升级给人工处理。
# 0.8 经带真实标签的评测集「阈值扫描」选定（python scripts/tune_threshold.py 可复现）
CONFIDENCE_THRESHOLD=0.8

# 天气查询的默认城市（客户没指定城市时使用）
DEFAULT_CITY=邵阳

# ---- RAG 语义检索 ----
# 中文语义向量模型（默认 bge-small-zh-v1.5，支持同义改写检索）。
# 国内下载会自动走 hf-mirror 镜像；模型不可用时自动回退本地哈希。
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---- 微信公众号（可选，接入微信客服时填写）----
# 公众号后台「服务器配置」里的 Token，需与此处完全一致
WECHAT_TOKEN=ai_ticket_wechat_token
