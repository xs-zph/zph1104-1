# ============================================================
# AI客服工单自动化系统 配置文件（示例）
# 使用方法：复制本文件为 .env，然后填入你自己的密钥
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# ============================================================

# ---- DeepSeek 大模型 ----
# DeepSeek API 密钥（必填）。到 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=sk-你的密钥
# 模型：deepseek-chat（V3，快）/ deepseek-reasoner（R1，带深度推理）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：覆盖为任意 OpenAI 兼容服务（例如 Ollama / vLLM）。
# 配置 LLM_BASE_URL 后本地服务可以不填写 LLM_API_KEY。
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# ---- 图片识别（可选，需填写兼容 OpenAI 视觉格式的模型）----
# 未配置时图片会自动转人工，不会伪造识别结果
VISION_MODEL=
# 不填则复用 DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY
VISION_BASE_URL=
VISION_API_KEY=
MAX_IMAGE_BYTES=8388608
# 单张图片宽高均不得超过 10000 像素

# ---- 企业部署基础设施（可选；生产环境建议配置）----
# REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=ai_ticket:
DB_POOL_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
DEFAULT_SLA_MINUTES=30

# ---- MySQL 数据库 ----
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DB=ai_ticket

# 登录会话有效期（秒，默认 8 小时）
SESSION_TTL_SECONDS=28800
# 浏览器会话 Cookie 配置；生产 HTTPS 环境必须开启 Secure
SESSION_COOKIE_NAME=ai_ticket_session
SESSION_COOKIE_SECURE=false

# ---- 首次登录手机号验证 ----
# 演示模式使用此测试码；生产环境关闭 DEMO_DATA_ENABLED 并接入短信服务。
PHONE_VERIFICATION_TEST_CODE=123456
PHONE_VERIFICATION_TTL_SECONDS=300
PHONE_VERIFICATION_MAX_ATTEMPTS=5

# ---- 业务参数 ----
# 分类置信度阈值：低于该值的工单升级给人工处理（默认 0.85）
CONFIDENCE_THRESHOLD=0.85

# 客户无新消息达到该时长后，后台自动结束人工会话；设为 0 可关闭
HUMAN_IDLE_TIMEOUT_MINUTES=30

# 每个应用进程用于异步提取用户画像的后台线程数
PROFILE_MAX_WORKERS=2

# ---- MCP 只读业务工具 ----
MCP_ENABLED=true
# 默认使用项目内的订单/物流/退款 MCP Server，可按环境覆盖
# MCP_SERVER_PATH=mcp_servers/business_server.py
MCP_TIMEOUT_SECONDS=8

# ---- 大模型并发与容错 ----
LLM_MAX_WORKERS=4
LLM_QUEUE_SIZE=32
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_SECONDS=30

# 本地演示数据（开发环境开启；生产环境建议关闭）
DEMO_DATA_ENABLED=true
