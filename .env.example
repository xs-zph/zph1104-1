# ============================================================
# AI客服工单自动化系统 配置文件（示例）
# 使用方法：复制本文件为 .env，然后填入你自己的密钥
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# ============================================================

# ---- DeepSeek 大模型 ----
# DeepSeek API 密钥（必填）。到 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=sk-你的密钥
# 模型：deepseek-chat（V3，快）/ deepseek-reasoner（R1，带深度推理）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- MySQL 数据库 ----
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DB=ai_ticket

# ---- 业务参数 ----
# 分类置信度阈值：低于该值的工单升级给人工处理（默认 0.85）
CONFIDENCE_THRESHOLD=0.85
